# Prevent unrelated local data, browser state, credentials, and temporary files from entering this repository.
*
!.gitignore
!Balaji_Rajput_Pharma_Outreach_Automation_Report.md
!master_pharma_automation.py
!vadodara_outreach_engine.py
!vadodara_vacancy_monitor.py
!vadodara_pharma_companies.json
!vadodara_active_vacancies.json
!daily_outreach_rules.md
!daily_outreach_log.md
!sent_emails.txt
!.github/
!.github/workflows/
!.github/workflows/*.yml
!artifacts/
!artifacts/*.pdf
!tests/
!tests/*.py
!pytest.ini

# Explicit sensitive and runtime exclusions
.env
.secrets/
.manus/
.mcp/
.browser_data_dir/
browser_html/
page_texts/
screenshots/
terminal_full_output/
upload/
*.pyc
__pycache__/
.cache/
.config/
.gemini/
.logs/
.npm/
.nvm/
.local/
